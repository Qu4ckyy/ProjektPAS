# Skopiuj do .env.local i uzupełnij. Szczegóły: CONTRACT.md §1.

# Connection string z MongoDB Atlas (Connect → Drivers).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Każdy ma swoją bazę: pociag_mateusz / pociag_kamil / pociag_eryk. Testy: pociag_test. Produkcja: pociag.
MONGODB_DB=pociag_twoje_imie

# Czas ważności rezerwacji w sekundach. Domyślnie 900 (15 min), na testy CEO 120.
RESERVATION_TTL_SECONDS=900

# --- Etap II: Stripe (tylko tryb testowy) — CONTRACT.md §1 ---

# Klucz testowy: Stripe Dashboard (sandbox) → Developers → API keys → Secret key. Musi zaczynać się od sk_test_.
# Nigdy nie commituj, nigdy nie dawaj prefiksu NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...

# Lokalnie: wypisuje go `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# Na Vercelu: sekret endpointu z Stripe Dashboard → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...

# Adres aplikacji bez / na końcu — z niego powstają adresy powrotu ze Stripe (nigdy z nagłówka Host).
APP_URL=http://localhost:3000

# Limit ruchu na IP (kryterium B5): ile żądań w oknie i długość okna w sekundach.
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_SECONDS=10
