# Skopiuj do .env.local i uzupełnij. Szczegóły: CONTRACT.md §1.

# Connection string z MongoDB Atlas (Connect → Drivers).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Każdy ma swoją bazę: pociag_mateusz / pociag_kamil / pociag_eryk. Testy: pociag_test. Produkcja: pociag.
MONGODB_DB=pociag_twoje_imie

# Czas ważności rezerwacji w sekundach. Domyślnie 900 (15 min), na testy CEO 120.
RESERVATION_TTL_SECONDS=900

# --- Etap II: Stripe (tylko tryb testowy) — CONTRACT.md §1 ---

# Klucz testowy: Stripe Dashboard (sandbox) → Developers → API keys → Secret key. Musi zaczynać się od sk_test_.
# Nigdy nie commituj, nigdy nie dawaj prefiksu NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...

# Lokalnie: wypisuje go `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# Na Vercelu: sekret endpointu z Stripe Dashboard → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...

# Adres aplikacji bez / na końcu — z niego powstają adresy powrotu ze Stripe (nigdy z nagłówka Host).
APP_URL=http://localhost:3000

# Limit ruchu na IP (kryterium B5): ile żądań w oknie i długość okna w sekundach.
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_SECONDS=10

# --- Etap III: punkty (Voucherify Loyalty Hub v2) i mail (Resend) — CONTRACT.md §1, D21 ---

# memory = punkty w pamięci serwera (testy, praca lokalna, bez zjadania limitu 100 wywołań/h);
# voucherify = prawdziwy sandbox. Na Vercelu kod zawsze używa voucherify.
LOYALTY_PROVIDER=memory

# Voucherify → Project settings: adres API (region Europe) i Application keys. Klucze tylko tutaj i na Vercelu.
VOUCHERIFY_API_URL=https://api.voucherify.io
VOUCHERIFY_APP_ID=
VOUCHERIFY_SECRET_KEY=

# Program „Konduktor punkty” i portfel „Punkty” w Loyalty Hub (to nie sekrety).
VOUCHERIFY_PROGRAM_ID=lprg_1353662608979a6d4e
VOUCHERIFY_CARD_DEFINITION_ID=lcdef_135367367d579a1d98

# log = mail tylko w konsoli serwera; resend = prawdziwa wysyłka. Na Vercelu kod zawsze używa resend.
MAIL_PROVIDER=log

# Resend → API Keys (uprawnienie „Sending access”). Bez własnej domeny dociera tylko na adres właściciela
# konta i adresy testowe: delivered@resend.dev, bounced@resend.dev (z dowolną etykietą po +).
RESEND_API_KEY=
MAIL_FROM=Konduktor <onboarding@resend.dev>

# Sekret dziennego crona /api/cron/settle (Vercel wysyła go sam). Np. `openssl rand -hex 32`.
CRON_SECRET=
